generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RolUsuario {
  ADMIN
}

enum NivelCurso {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
  TODOS_LOS_NIVELES
}

enum ModalidadCurso {
  EN_LINEA
  PRESENCIAL
  HIBRIDA
}

enum EstadoConsulta {
  PENDIENTE
  LEIDA
  RESPONDIDA
}

enum EstadoPromocion {
  ACTIVA
  INACTIVA
  EXPIRADA
}

model Usuario {
  id                     String                  @id @default(uuid())
  correo                 String                  @unique
  hashContrasena         String                  @map("hash_contrasena")
  nombre                 String
  apellido               String
  rol                    RolUsuario              @default(ADMIN)
  activo                 Boolean                 @default(true)
  creadoEn               DateTime                @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn          DateTime                @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  tokensRestablecimiento TokenRestablecimiento[]

  @@index([rol])
  @@index([activo])
  @@map("usuarios")
}

model Negocio {
  id               String   @id @default(uuid())
  claveUnica       String   @unique @default("negocio") @map("clave_unica")
  nombre           String
  descripcion      String?
  direccion        String?
  telefono         String?
  correo           String?
  enlacesSociales  Json?    @map("enlaces_sociales")
  horariosAtencion Json?    @map("horarios_atencion")
  creadoEn         DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@map("negocios")
}

model Categoria {
  id            String   @id @default(uuid())
  nombre        String   @unique
  slug          String   @unique
  descripcion   String?
  activa        Boolean  @default(true)
  creadaEn      DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)
  actualizadaEn DateTime @updatedAt @map("actualizada_en") @db.Timestamptz(3)
  cursos        Curso[]

  @@index([activa])
  @@map("categorias")
}

model Curso {
  id               String         @id @default(uuid())
  categoriaId      String         @map("categoria_id")
  titulo           String
  slug             String         @unique
  descripcion      String?
  duracion         String
  cuposDisponibles Int            @default(0) @map("cupos_disponibles")
  fechaInicio      DateTime       @map("fecha_inicio") @db.Timestamptz(3)
  precio           Decimal        @db.Decimal(10, 2)
  nivel            NivelCurso     @default(TODOS_LOS_NIVELES)
  modalidad        ModalidadCurso @default(PRESENCIAL)
  activo           Boolean        @default(true)
  destacado        Boolean        @default(false)
  creadoEn         DateTime       @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime       @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  categoria        Categoria      @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  imagenes         ImagenCurso[]
  consultas        Consulta[]
  promociones      Promocion[]

  @@index([categoriaId, activo])
  @@index([activo, fechaInicio])
  @@index([modalidad, activo])
  @@index([destacado, activo])
  @@map("cursos")
}

model ImagenCurso {
  id               String   @id @default(uuid())
  cursoId          String   @map("curso_id")
  url              String
  idPublico        String?  @unique @map("id_publico")
  textoAlternativo String?  @map("texto_alternativo")
  orden            Int      @default(0)
  creadaEn         DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)
  curso            Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@index([cursoId, orden])
  @@map("imagenes_curso")
}

model Consulta {
  id            String         @id @default(uuid())
  cursoId       String?        @map("curso_id")
  nombre        String
  correo        String
  telefono      String?
  asunto        String
  mensaje       String
  estado        EstadoConsulta @default(PENDIENTE)
  creadaEn      DateTime       @default(now()) @map("creada_en") @db.Timestamptz(3)
  actualizadaEn DateTime       @updatedAt @map("actualizada_en") @db.Timestamptz(3)
  curso         Curso?         @relation(fields: [cursoId], references: [id], onDelete: SetNull)

  @@index([cursoId])
  @@index([estado, creadaEn])
  @@index([correo])
  @@map("consultas")
}

model Promocion {
  id                  String          @id @default(uuid())
  cursoId             String?         @map("curso_id")
  titulo              String
  descripcion         String?
  porcentajeDescuento Int?            @map("porcentaje_descuento")
  estado              EstadoPromocion @default(ACTIVA)
  fechaInicio         DateTime?       @map("fecha_inicio") @db.Timestamptz(3)
  fechaFin            DateTime?       @map("fecha_fin") @db.Timestamptz(3)
  creadaEn            DateTime        @default(now()) @map("creada_en") @db.Timestamptz(3)
  actualizadaEn       DateTime        @updatedAt @map("actualizada_en") @db.Timestamptz(3)
  curso               Curso?          @relation(fields: [cursoId], references: [id], onDelete: SetNull)

  @@index([cursoId])
  @@index([estado, fechaInicio, fechaFin])
  @@map("promociones")
}

model TokenRestablecimiento {
  id        String    @id @default(uuid())
  usuarioId String    @map("usuario_id")
  hashToken String    @unique @map("hash_token")
  expiraEn  DateTime  @map("expira_en") @db.Timestamptz(3)
  usadoEn   DateTime? @map("usado_en") @db.Timestamptz(3)
  creadoEn  DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, usadoEn, expiraEn])
  @@map("tokens_restablecimiento")
}
